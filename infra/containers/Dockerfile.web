FROM node:24-alpine AS build
WORKDIR /source/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY i18n/ /source/i18n/
ENV VITE_PINELINK_API_URL=/api VITE_PINELINK_OWNER=dev-owner
RUN npm run build
ARG VERSION
RUN node -e 'const fs=require("fs"); if(!process.env.VERSION) throw Error("Missing version"); fs.writeFileSync("dist/version.json",JSON.stringify({version:process.env.VERSION,client:"web",profile:"private-preview"}))'

FROM nginx:stable-alpine
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/simiooo/pinelink" org.opencontainers.image.revision=$VERSION
COPY --from=build /source/web/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx", "-c", "/etc/pinelink/nginx.conf", "-g", "daemon off;"]
