FROM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS build
WORKDIR /source
COPY backend/go.mod backend/go.sum ./
ENV GOWORK=off
RUN go mod download
COPY backend/ ./
ARG VERSION
RUN test -n "$VERSION" && CGO_ENABLED=0 go build -p 2 -trimpath -buildvcs=false -ldflags "-s -w -X github.com/simiooo/pinelink/backend/internal/httpapi.BuildVersion=$VERSION" -o /pinelinkd ./cmd/pinelinkd

FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 pinelink
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/simiooo/pinelink" org.opencontainers.image.revision=$VERSION
WORKDIR /app
COPY --from=build --chmod=755 /pinelinkd /app/pinelinkd
COPY infra/migrations/ /app/migrations/
COPY LICENSE NOTICE /usr/share/licenses/pinelink/
USER 10001:10001
ENV PINELINK_MIGRATIONS_DIR=/app/migrations
EXPOSE 8080
ENTRYPOINT ["/app/pinelinkd"]
